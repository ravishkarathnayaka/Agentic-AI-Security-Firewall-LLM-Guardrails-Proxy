# Proxy Networking Configuration
PROXY_HOST=0.0.0.0
PROXY_PORT=8080

# Upstream LLM Configuration
# Use http://mock-llm:8081 for the dockerized mock LLM
# Use http://host.docker.internal:11434 for local Ollama
# Use https://api.openai.com for upstream OpenAI
UPSTREAM_LLM_URL=http://mock-llm:8081
UPSTREAM_API_KEY=your-upstream-api-key
REQUEST_TIMEOUT_SECONDS=60.0

# Guardrail Controls
ENABLE_PROMPT_INJECTION_GUARD=true
ENABLE_PII_SANITIZER=true
ENABLE_SYSTEM_PROMPT_GUARD=true
ENABLE_OUTPUT_SANITIZER=true
ENABLE_TOOL_CALL_VALIDATOR=true

# Security Tuning
INJECTION_THRESHOLD=0.60
CANARY_TOKEN=CANARY_SEC_TOKEN_9941a8
DE_ANONYMIZE_OUTPUT=false

# Logging & Telemetry
LOG_LEVEL=INFO
AUDIT_LOG_FILE=audit_logs.jsonl
